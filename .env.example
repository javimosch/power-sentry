# PowerSentry - Configuration Template
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control!

# Proxmox host (worker target)
PROXMOX_HOST=<proxmox-host>

# Jump host (bastion / intermediate host, optional)
JUMP_HOST=<jump-host>
JUMP_USER=<jump-user>

# Remote user on Proxmox target
REMOTE_USER=root

# Control panel server
DK1_HOST=<control-panel-host>
DK1_USER=<control-panel-user>
